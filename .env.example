PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/bni_app
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=30d

# Optional, local machine only - leave unset to use the default
# data/members.json inside this repo. Set this to read the member roster
# from a different file on your own machine instead (e.g. one you keep
# open in your editor), without affecting anyone else or production.
# MEMBERS_FILE=C:\path\to\your\member_names.json

# Saptel DLT SMS (login OTP). SAPTEL_TEMPLATE must contain {otp} and match the
# DLT-registered text for SAPTEL_TID exactly. Leave unset for dev mode: the
# OTP is printed in this server's terminal instead.
# SAPTEL_API_KEY=your_saptel_api_key
# SAPTEL_SENDER=ABCDEF
# SAPTEL_ROUTE_TYPE=1
# SAPTEL_TID=your_dlt_template_id
# SAPTEL_TEMPLATE="{otp} is the OTP for your login. ..."
